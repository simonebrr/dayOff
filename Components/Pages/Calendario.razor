@page "/calendario"
@inject IDbContextFactory<AppDbContext> DbFactory
@inject AuthService Auth
@inject NavigationManager Nav
@inject IConfiguration _config
@inject RichiesteService Richieste
@using GestioneFerie.Web.Services
@using GestioneFerie.Web.Models
@using GestioneFerie.Web.Data
@using Microsoft.EntityFrameworkCore
@rendermode InteractiveServer

<PageTitle>Calendario</PageTitle>

<div class="page-header">
  <h2>Calendario ferie</h2>
  <p class="subtitle">Visualizza le ferie e permessi</p>
</div>

<div class="filtri">
  <div class="filtro-group">
    <label>Dal</label>
    <input type="date" value="@dalData.ToString("yyyy-MM-dd")"
           @onchange="e => { dalData = DateTime.Parse(e.Value!.ToString()!); Filtra(); }" />
  </div>
  <div class="filtro-group">
    <label>Al</label>
    <input type="date" value="@alData.ToString("yyyy-MM-dd")"
           @onchange="e => { alData = DateTime.Parse(e.Value!.ToString()!); Filtra(); }" />
  </div>
  <div class="filtro-group">
    <label>Tipo</label>
    <select @bind="tipoScelto" @bind:after="Filtra">
      <option value="">Tutti</option>
      <option value="Ferie">🌴 Ferie</option>
      <option value="Permesso">🕐 Permesso</option>
      <option value="Malattia">🤒 Malattia</option>
    </select>
  </div>
  <div class="filtro-group">
    <label>Stato</label>
    <select @bind="statoScelto" @bind:after="Filtra">
      <option value="">Tutti</option>
      <option value="InAttesa">⏳ In attesa</option>
      <option value="Approvata">✅ Approvata</option>
      <option value="Rifiutata">❌ Rifiutata</option>
    </select>
  </div>
  @if (Auth.IsCapo)
  {
    <div class="filtro-group autocomplete-wrapper">
      <label>Dipendente</label>
      <input type="text" placeholder="Tutti i dipendenti" value="@cercaDipendente" @oninput="OnCercaDipendente"
             @onfocus="OnFocusDipendente" />
      @if (suggerimenti.Any())
      {
        <div class="autocomplete-list">
          @if (!string.IsNullOrEmpty(cercaDipendente))
          {
            <div class="autocomplete-item reset" @onclick="ResetDipendente">
              ✕ Tutti i dipendenti
            </div>
          }
          @foreach (var d in suggerimenti)
          {
            <div class="autocomplete-item" @onclick="() => SelezionaDipendente(d)">
              @d.Nome @d.Cognome
            </div>
          }
        </div>
      }
    </div>
  }
</div>

@if (!richieste.Any())
{
  <div class="empty-state">Nessuna richiesta trovata per i filtri selezionati 📅</div>
}
else
{
  <div class="table-card">
    <table class="table">
      <thead>
        <tr>
          @if (Auth.IsCapo)
          {
            <th>Dipendente</th>
          }
          <th>Tipo</th>
          <th>Dal</th>
          <th>Al</th>
          <th>Ore</th>
          <th>Stato</th>
          <th>Note</th>
          @if (!Auth.IsCapo)
          {
            <th>Azioni</th>
          }
        </tr>
      </thead>
      <tbody>
        @foreach (var r in richieste)
        {
          <tr>
            @if (Auth.IsCapo)
            {
              <td>@r.Utente.Nome @r.Utente.Cognome</td>
            }
            <td>
              <span class="badge @BadgeHelper.TipoBadgeClass(r.Tipo)">
                @r.Tipo
              </span>
            </td>
            <td>@r.DataInizio.ToString("dd/MM/yyyy")</td>
            <td>@r.DataFine.ToString("dd/MM/yyyy")</td>
            <td>@r.OreRichieste</td>
            <td><span class="badge @BadgeHelper.StatoBadgeClass(r.Stato)">@r.Stato</span></td>
            <td>@(r.Note ?? "—")</td>
            @if (!Auth.IsCapo)
            {
              <td>
                @if (r.Stato == StatoRichiesta.InAttesa || r.Stato == StatoRichiesta.Approvata)
                {
                  <button class="btn-elimina" @onclick="() => ApriConfermaElimina(r.Id)">🗑️ Elimina</button>
                }
              </td>
            }
          </tr>
        }
      </tbody>
    </table>
  </div>

  <div class="totali">
    <div class="totale-item">
      <span class="totale-label">Totale richieste</span>
      <span class="totale-value">@richieste.Count</span>
    </div>
    <div class="totale-item">
      <span class="totale-label">Totale ore</span>
      <span class="totale-value">@richieste.Sum(r => r.OreRichieste) h</span>
    </div>
    <div class="totale-item">
      <span class="totale-label">Di cui ferie</span>
      <span class="totale-value">@richieste.Where(r => r.Tipo == TipoRichiesta.Ferie).Sum(r => r.OreRichieste) h</span>
    </div>
    <div class="totale-item">
      <span class="totale-label">Di cui permessi</span>
      <span class="totale-value">@richieste.Where(r => r.Tipo == TipoRichiesta.Permesso).Sum(r => r.OreRichieste) h</span>
    </div>
  </div>
}

@if (mostraConfermaElimina)
{
  <div class="modal-overlay">
    <div class="modal-box">
      <h3>Conferma eliminazione</h3>
      <p>Sei sicuro di voler eliminare questa richiesta?</p>
      @if (richiestaConfermaStato == StatoRichiesta.Approvata)
      {
        <p class="modal-warning">⚠️ Questa richiesta è già approvata — le ore verranno restituite al tuo saldo.</p>
      }
      <div class="modal-actions">
        <button class="btn-elimina" @onclick="ConfermaElimina">🗑️ Elimina</button>
        <button class="btn-cancel" @onclick="() => mostraConfermaElimina = false">Annulla</button>
      </div>
    </div>
  </div>
}

@code {
  List<RichiestaFerie> richieste = new();
  List<Utente> dipendenti = new();
  List<RichiestaFerie> tutteLeRichieste = new();

  DateTime dalData = new DateTime(DateTime.Now.Year, 1, 1);
  DateTime alData = new DateTime(DateTime.Now.Year, 12, 31);
  string tipoScelto = "";
  string statoScelto = "";
  int dipendenteScelto = 0;

  bool mostraConfermaElimina = false;
  int richiestaEliminaId;
  StatoRichiesta richiestaConfermaStato;

  string cercaDipendente = "";
  List<Utente> suggerimenti = new();

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (firstRender)
    {
      if (!Auth.IsAuthenticated)
      {
        Nav.NavigateTo("/login");
        return;
      }
      await CancellaScaduteInAttesa();
      await CaricaRichieste();
      Filtra();
      StateHasChanged();
    }
  }

  async Task CancellaScaduteInAttesa()
  {
    await Richieste.RimuoviScaduteInAttesaAsync(Auth.IsCapo ? Auth.AziendaId : null, Auth.IsCapo ? null : Auth.UtenteId);
  }

  async Task CaricaRichieste()
  {
    using var db = DbFactory.CreateDbContext();

    if (Auth.IsCapo)
    {
      dipendenti = await db.Utenti
          .Where(u => u.Ruolo == Ruolo.Dipendente && u.AziendaId == Auth.AziendaId)
          .ToListAsync();

      tutteLeRichieste = await db.RichiestaFerie
          .Include(r => r.Utente)
          .Where(r => r.Utente.AziendaId == Auth.AziendaId)
          .OrderBy(r => r.DataInizio)
          .ToListAsync();
    }
    else
    {
      tutteLeRichieste = await db.RichiestaFerie
          .Include(r => r.Utente)
          .Where(r => r.UtenteId == Auth.UtenteId)
          .OrderBy(r => r.DataInizio)
          .ToListAsync();
    }
  }

  void Filtra()
  {
    richieste = tutteLeRichieste.Where(r =>
    {
      bool okData = r.DataInizio <= alData && r.DataFine >= dalData;
      bool okTipo = string.IsNullOrEmpty(tipoScelto) || r.Tipo.ToString() == tipoScelto;
      bool okStato = string.IsNullOrEmpty(statoScelto) || r.Stato.ToString() == statoScelto;
      bool okDipendente = dipendenteScelto == 0 || r.UtenteId == dipendenteScelto;
      return okData && okTipo && okStato && okDipendente;
    }).ToList();
  }

  void ApriConfermaElimina(int id)
  {
    richiestaEliminaId = id;
    richiestaConfermaStato = tutteLeRichieste.First(r => r.Id == id).Stato;
    mostraConfermaElimina = true;
  }

  async Task ConfermaElimina()
  {
    mostraConfermaElimina = false;
    await InvokeAsync(StateHasChanged);

    var emailHR = _config["EmailHR"];
    var richiesta = await Richieste.EliminaAsync(richiestaEliminaId, emailHR);
    if (richiesta == null) return;

    tutteLeRichieste.RemoveAll(r => r.Id == richiestaEliminaId);
    Filtra();
    await InvokeAsync(StateHasChanged);
  }

  void OnFocusDipendente()
  {
    suggerimenti = string.IsNullOrWhiteSpace(cercaDipendente)
        ? dipendenti
        : dipendenti
            .Where(d => $"{d.Nome} {d.Cognome}".Contains(cercaDipendente, StringComparison.OrdinalIgnoreCase))
            .ToList();
  }

  void OnCercaDipendente(ChangeEventArgs e)
  {
    cercaDipendente = e.Value?.ToString() ?? "";
    if (string.IsNullOrWhiteSpace(cercaDipendente))
    {
      suggerimenti = dipendenti;
      dipendenteScelto = 0;
      Filtra();
      return;
    }
    suggerimenti = dipendenti
        .Where(d => $"{d.Nome} {d.Cognome}".Contains(cercaDipendente, StringComparison.OrdinalIgnoreCase))
        .ToList();
  }

  void SelezionaDipendente(Utente d)
  {
    dipendenteScelto = d.Id;
    cercaDipendente = $"{d.Nome} {d.Cognome}";
    suggerimenti = new();
    Filtra();
  }

  void ResetDipendente()
  {
    dipendenteScelto = 0;
    cercaDipendente = "";
    suggerimenti = new();
    Filtra();
  }
}