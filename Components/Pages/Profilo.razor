@page "/profilo"
@inject IDbContextFactory<AppDbContext> DbFactory
@inject AuthService Auth
@inject NavigationManager Nav
@using GestioneFerie.Web.Services
@using GestioneFerie.Web.Models
@using GestioneFerie.Web.Data
@using Microsoft.EntityFrameworkCore
@rendermode InteractiveServer

<PageTitle>Profilo</PageTitle>

<div class="page-header">
  <h2>Il mio profilo</h2>
  <p class="subtitle">Gestisci i tuoi dati personali</p>
</div>

@if (!string.IsNullOrEmpty(messaggio))
{
  <div class="alert @(errore ? "alert-error" : "alert-success")">@messaggio</div>
}

@if (Auth.IsCapo)
{
  <div class="stats-row">
    <div class="stat-card">
      <div class="stat-label">👥 Dipendenti</div>
      <div class="stat-value">@statDipendenti</div>
    </div>
    <div class="stat-card">
      <div class="stat-label">⏳ Richieste in attesa</div>
      <div class="stat-value warning">@statInAttesa</div>
    </div>
    <div class="stat-card">
      <div class="stat-label">📅 Ore totali gestite @DateTime.Now.Year</div>
      <div class="stat-value">@statOreTotali h</div>
    </div>
  </div>
}

<div class="grid-2">
  <div>
    <div class="form-card" style="margin-bottom:1rem">
      <h3>Informazioni personali</h3>
      <div class="info-row">
        <span class="info-label">Nome</span>
        <span class="info-value">@utente?.Nome @utente?.Cognome</span>
      </div>
      <div class="info-row">
        <span class="info-label">Email</span>
        <span class="info-value">@utente?.Email</span>
      </div>
      <div class="info-row">
        <span class="info-label">Ruolo</span>
        <span class="role-badge @(Auth.IsCapo ? "badge-capo" : "badge-dipendente")">
          @(Auth.IsCapo ? "Capo" : "Dipendente")
        </span>
      </div>
    </div>

    @if (Auth.IsCapo && azienda != null)
    {
      <div class="form-card">
        <h3>La mia azienda</h3>
        <div class="info-row">
          <span class="info-label">Nome</span>
          <span class="info-value">@azienda.Nome</span>
        </div>
        <div class="info-row">
          <span class="info-label">Email malattia</span>
          <span class="info-value">
            @if (string.IsNullOrEmpty(azienda.EmailMalattia))
            {
              <span class="info-muted">Non configurata — arrivano a te</span>
            }
            else
            {
              @azienda.EmailMalattia
            }
          </span>
        </div>
      </div>
    }
  </div>

  <div class="form-card">
    <h3>Cambia password</h3>
    <div class="form-group">
      <label>Password attuale</label>
      <input type="password" @bind="vecchiaPassword" placeholder="••••••••" />
    </div>
    <div class="form-group">
      <label>Nuova password</label>
      <input type="password" @bind="nuovaPassword" placeholder="••••••••" />
    </div>
    <div class="form-group">
      <label>Conferma nuova password</label>
      <input type="password" @bind="confermaPassword" placeholder="••••••••" />
    </div>
    <button class="btn-primary" @onclick="CambiaPassword">Aggiorna password</button>
  </div>
</div>

@code {
  Utente? utente;
  GestioneFerie.Web.Models.Azienda? azienda;
  string messaggio = "";
  bool errore = false;
  string vecchiaPassword = "";
  string nuovaPassword = "";
  string confermaPassword = "";

  int statDipendenti;
  int statInAttesa;
  decimal statOreTotali;

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (firstRender)
    {
      if (!Auth.IsAuthenticated)
      {
        Nav.NavigateTo("/login");
        return;
      }
      await CaricaDati();
      StateHasChanged();
    }
  }

  async Task CaricaDati()
  {
    using var db = DbFactory.CreateDbContext();
    utente = await db.Utenti.FindAsync(Auth.UtenteId);

    if (Auth.IsCapo && Auth.AziendaId != null)
    {
      azienda = await db.Aziende.FindAsync(Auth.AziendaId);

      statDipendenti = await db.Utenti
          .CountAsync(u => u.AziendaId == Auth.AziendaId && u.Ruolo == Ruolo.Dipendente);

      statInAttesa = await db.RichiestaFerie
          .CountAsync(r => r.Stato == StatoRichiesta.InAttesa && r.Utente.AziendaId == Auth.AziendaId);

      statOreTotali = await db.SaldoFerie
          .Where(s => s.Anno == DateTime.Now.Year && s.Utente.AziendaId == Auth.AziendaId)
          .SumAsync(s => s.OreTotali);
    }
  }

  async Task CambiaPassword()
  {
    if (string.IsNullOrWhiteSpace(vecchiaPassword) || string.IsNullOrWhiteSpace(nuovaPassword))
    {
      messaggio = "Compila tutti i campi";
      errore = true;
      return;
    }
    if (nuovaPassword.Length < 6)
    {
      messaggio = "La nuova password deve essere di almeno 6 caratteri.";
      errore = true;
      return;
    }
    if (nuovaPassword != confermaPassword)
    {
      messaggio = "Le password non coincidono.";
      errore = true;
      return;
    }

    using var db = DbFactory.CreateDbContext();
    var utenteDb = await db.Utenti.FindAsync(Auth.UtenteId);
    if (utenteDb == null) return;

    if (!BCrypt.Net.BCrypt.Verify(vecchiaPassword, utenteDb.PasswordHash))
    {
      messaggio = "La password attuale non è corretta.";
      errore = true;
      return;
    }

    utenteDb.PasswordHash = BCrypt.Net.BCrypt.HashPassword(nuovaPassword);
    await db.SaveChangesAsync();

    messaggio = "Password aggiornata con successo!";
    errore = false;
    vecchiaPassword = nuovaPassword = confermaPassword = "";
  }
}
