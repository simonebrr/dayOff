@page "/admin"
@inject IDbContextFactory<AppDbContext> DbFactory
@inject AuthService Auth
@inject NavigationManager Nav
@inject EmailService EmailService
@using GestioneFerie.Web.Services
@using GestioneFerie.Web.Models
@using GestioneFerie.Web.Data
@using Microsoft.EntityFrameworkCore
@rendermode InteractiveServer

<PageTitle>Pannello Admin</PageTitle>

<div class="page-header">
  <div>
    <h2>Pannello Admin</h2>
    <p class="subtitle">Gestisci le aziende registrate nel sistema</p>
  </div>
  <button class="btn-primary" @onclick="() => mostraModalNuova = true">+ Nuova azienda</button>
</div>

@if (!string.IsNullOrEmpty(messaggio))
{
  <div class="alert @(errore ? "alert-error" : "alert-success")">@messaggio</div>
}

@if (!aziende.Any())
{
  <div class="empty-state">Nessuna azienda ancora. Creane una! 👆</div>
}
else
{
  <div class="table-card">
    <table class="table">
      <thead>
        <tr>
          <th>Azienda</th>
          <th>Capo</th>
          <th>Email capo</th>
          <th>Email malattia</th>
          <th>Dipendenti</th>
          <th>Azioni</th>
        </tr>
      </thead>
      <tbody>
        @foreach (var a in aziende)
        {
          <tr>
            <td><strong>@a.Nome</strong></td>
            <td>@a.Capo?.Nome @a.Capo?.Cognome</td>
            <td>@a.Capo?.Email</td>
            <td>@(string.IsNullOrEmpty(a.EmailMalattia) ? "— (va al capo)" : a.EmailMalattia)</td>
            <td>@conteggioUtenti.GetValueOrDefault(a.Id)</td>
            <td>
              <button class="btn-edit" @onclick="() => ApriModifica(a)">✏️ Modifica</button>
              <button class="btn-danger" @onclick="() => ApriConfermaElimina(a)">🗑️ Elimina</button>
            </td>
          </tr>
        }
      </tbody>
    </table>
  </div>
}

@if (mostraModalNuova)
{
  <div class="modal-overlay">
    <div class="modal">
      <h3>Nuova azienda</h3>

      <div class="form-group">
        <label>Nome azienda</label>
        <input type="text" @bind="nuovoNomeAzienda" placeholder="Es. Acme S.r.l." />
      </div>
      <div class="form-group">
        <label>Email malattia <span class="hint">(opzionale)</span></label>
        <input type="email" @bind="nuovaEmailMalattia" placeholder="hr@azienda.it" />
      </div>

      <hr style="margin: 1rem 0; border-color: #eee;" />
      <p style="font-weight:600; margin-bottom:.75rem;">Dati del capo</p>

      <div class="form-row">
        <div class="form-group">
          <label>Nome</label>
          <input type="text" @bind="nuovoNomeCapo" placeholder="Mario" />
        </div>
        <div class="form-group">
          <label>Cognome</label>
          <input type="text" @bind="nuovoCognomeCapo" placeholder="Rossi" />
        </div>
      </div>
      <div class="form-group">
        <label>Email capo</label>
        <input type="email" @bind="nuovaEmailCapo" placeholder="mario.rossi@azienda.it" />
      </div>

      <div class="modal-actions">
        <button class="btn-primary" @onclick="CreaAzienda" disabled="@creando">
          @(creando ? "Creazione..." : "Crea azienda")
        </button>
        <button class="btn-cancel" @onclick="ChiudiModal">Annulla</button>
      </div>
    </div>
  </div>
}

@if (mostraModalModifica)
{
  <div class="modal-overlay">
    <div class="modal">
      <h3>Modifica azienda</h3>

      <div class="form-group">
        <label>Nome azienda</label>
        <input type="text" @bind="modificaNome" />
      </div>
      <div class="form-group">
        <label>Email malattia <span class="hint">(opzionale — se vuota, va al capo)</span></label>
        <input type="email" @bind="modificaEmailMalattia" placeholder="hr@azienda.it" />
      </div>

      <div class="modal-actions">
        <button class="btn-primary" @onclick="SalvaModifica">Salva</button>
        <button class="btn-cancel" @onclick="() => mostraModalModifica = false">Annulla</button>
      </div>
    </div>
  </div>
}

@if (mostraConfermaElimina)
{
  <div class="modal-overlay">
    <div class="modal">
      <h3>Conferma eliminazione</h3>
      <p>Sei sicuro di voler eliminare <strong>@aziendaDaEliminare?.Nome</strong>?</p>
      <p style="color:#A32D2D; font-size:0.9rem">⚠️ Verranno eliminati anche tutti i dipendenti, le richieste e i saldi
        ferie associati.</p>
        <div class="modal-actions">
          <button class="btn-danger" @onclick="ConfermaElimina">🗑️ Elimina definitivamente</button>
          <button class="btn-cancel" @onclick="() => mostraConfermaElimina = false">Annulla</button>
        </div>
      </div>
    </div>
  }

@code {
  List<GestioneFerie.Web.Models.Azienda> aziende = new();
  Dictionary<int, int> conteggioUtenti = new();
  bool mostraModalNuova = false;
  bool creando = false;
  string messaggio = "";
  bool errore = false;

  string nuovoNomeAzienda = "";
  string nuovaEmailMalattia = "";
  string nuovoNomeCapo = "";
  string nuovoCognomeCapo = "";
  string nuovaEmailCapo = "";

  bool mostraModalModifica = false;
  int modificaAziendaId;
  string modificaNome = "";
  string modificaEmailMalattia = "";

  bool mostraConfermaElimina = false;
  GestioneFerie.Web.Models.Azienda? aziendaDaEliminare;

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (firstRender)
    {
      if (!Auth.IsAuthenticated || !Auth.IsSuperAdmin)
      {
        Nav.NavigateTo("/login");
        return;
      }
      await CaricaAziende();
      StateHasChanged();
    }
  }

  async Task CaricaAziende()
  {
    using var db = DbFactory.CreateDbContext();
    aziende = await db.Aziende
        .Include(a => a.Capo)
        .OrderBy(a => a.Nome)
        .ToListAsync();

    var ids = aziende.Select(a => a.Id).ToList();
    conteggioUtenti = await db.Utenti
        .Where(u => u.AziendaId != null && ids.Contains(u.AziendaId!.Value) && u.Ruolo == Ruolo.Dipendente)
        .GroupBy(u => u.AziendaId!.Value)
        .ToDictionaryAsync(g => g.Key, g => g.Count());
  }

  void ApriModifica(GestioneFerie.Web.Models.Azienda a)
  {
    modificaAziendaId = a.Id;
    modificaNome = a.Nome;
    modificaEmailMalattia = a.EmailMalattia ?? "";
    mostraModalModifica = true;
  }

  void ApriConfermaElimina(GestioneFerie.Web.Models.Azienda a)
  {
    aziendaDaEliminare = a;
    mostraConfermaElimina = true;
  }

  async Task ConfermaElimina()
  {
    if (aziendaDaEliminare == null) return;
    mostraConfermaElimina = false;

    using var db = DbFactory.CreateDbContext();

    var utenti = await db.Utenti
        .Where(u => u.AziendaId == aziendaDaEliminare.Id)
        .ToListAsync();

    var utenteIds = utenti.Select(u => u.Id).ToList();

    // Elimina richieste
    var richieste = await db.RichiestaFerie
        .Where(r => utenteIds.Contains(r.UtenteId))
        .ToListAsync();
    db.RichiestaFerie.RemoveRange(richieste);
    await db.SaveChangesAsync();

    // Elimina saldi
    var saldi = await db.SaldoFerie
        .Where(s => utenteIds.Contains(s.UtenteId))
        .ToListAsync();
    db.SaldoFerie.RemoveRange(saldi);
    await db.SaveChangesAsync();

    // Elimina log
    var log = await db.LogModificheSaldo
        .Where(l => utenteIds.Contains(l.UtenteId))
        .ToListAsync();
    db.LogModificheSaldo.RemoveRange(log);
    await db.SaveChangesAsync();

    // Prima togli CapoId dall'azienda
    var azienda = await db.Aziende.FindAsync(aziendaDaEliminare.Id);
    if (azienda != null)
    {
      azienda.CapoId = null;
      await db.SaveChangesAsync();
    }

    // Scollega utenti dall'azienda
    foreach (var u in utenti)
      u.AziendaId = null;
    await db.SaveChangesAsync();

    // Elimina utenti
    db.Utenti.RemoveRange(utenti);
    await db.SaveChangesAsync();

    // Elimina azienda
    if (azienda != null)
    {
      db.Aziende.Remove(azienda);
      await db.SaveChangesAsync();
    }

    messaggio = $"Azienda \"{aziendaDaEliminare.Nome}\" eliminata.";
    errore = false;
    aziendaDaEliminare = null;
    await CaricaAziende();
  }

  async Task SalvaModifica()
  {
    if (string.IsNullOrWhiteSpace(modificaNome))
    {
      messaggio = "Il nome azienda è obbligatorio.";
      errore = true;
      return;
    }
    using var db = DbFactory.CreateDbContext();
    var a = await db.Aziende.FindAsync(modificaAziendaId);
    if (a == null) return;
    a.Nome = modificaNome;
    a.EmailMalattia = string.IsNullOrWhiteSpace(modificaEmailMalattia) ? null : modificaEmailMalattia;
    await db.SaveChangesAsync();
    mostraModalModifica = false;
    messaggio = "Azienda aggiornata!";
    errore = false;
    await CaricaAziende();
  }

  async Task CreaAzienda()
  {
    if (string.IsNullOrWhiteSpace(nuovoNomeAzienda) ||
        string.IsNullOrWhiteSpace(nuovoNomeCapo) ||
        string.IsNullOrWhiteSpace(nuovaEmailCapo))
    {
      messaggio = "Compila nome azienda, nome e email del capo.";
      errore = true;
      return;
    }

    creando = true;
    using var db = DbFactory.CreateDbContext();

    if (await db.Utenti.AnyAsync(u => u.Email == nuovaEmailCapo))
    {
      messaggio = "Email capo già in uso.";
      errore = true;
      creando = false;
      return;
    }

    var password = GeneraPassword();

    var capo = new Utente
    {
      Nome = nuovoNomeCapo,
      Cognome = nuovoCognomeCapo,
      Email = nuovaEmailCapo,
      PasswordHash = BCrypt.Net.BCrypt.HashPassword(password),
      Ruolo = Ruolo.Capo
    };
    db.Utenti.Add(capo);
    await db.SaveChangesAsync();

    var azienda = new GestioneFerie.Web.Models.Azienda
    {
      Nome = nuovoNomeAzienda,
      EmailMalattia = string.IsNullOrWhiteSpace(nuovaEmailMalattia) ? null : nuovaEmailMalattia,
      CapoId = capo.Id
    };
    db.Aziende.Add(azienda);
    await db.SaveChangesAsync();

    capo.AziendaId = azienda.Id;
    await db.SaveChangesAsync();

    var emailSnapshot = nuovaEmailCapo;
    var nomeSnapshot = nuovoNomeCapo;
    var nomeAziendaSnapshot = nuovoNomeAzienda;

    messaggio = $"Azienda \"{nuovoNomeAzienda}\" creata! Credenziali inviate a {nuovaEmailCapo}.";
    errore = false;
    ChiudiModal();
    await CaricaAziende();
    await InvokeAsync(StateHasChanged);

    _ = Task.Run(() => EmailService.InviaAsync(
        emailSnapshot,
        $"Benvenuto su Gestione Ferie — {nomeAziendaSnapshot}",
        $"""
        <p>Ciao {nomeSnapshot},</p>
        <p>Il tuo account da <strong>capo</strong> per l'azienda <strong>{nomeAziendaSnapshot}</strong> è stato creato.</p>
        <p>Email: <strong>{emailSnapshot}</strong></p>
        <p>Password: <strong>{password}</strong></p>
        <p>Accedi e aggiungi i tuoi dipendenti dalla sezione <em>Dipendenti</em>.</p>
        """
    ));

    creando = false;
  }

  void ChiudiModal()
  {
    mostraModalNuova = false;
    nuovoNomeAzienda = nuovaEmailMalattia = nuovoNomeCapo = nuovoCognomeCapo = nuovaEmailCapo = "";
  }

  string GeneraPassword()
  {
    const string chars = "ABCDEFGHJKLMNPQRSTUVWXYZabcdefghjkmnpqrstuvwxyz23456789!@#$";
    var random = new Random();
    return new string(Enumerable.Range(0, 12).Select(_ => chars[random.Next(chars.Length)]).ToArray());
  }
}