@page "/admin"
@inject IDbContextFactory<AppDbContext> DbFactory
@inject AuthService Auth
@inject NavigationManager Nav
@inject EmailService EmailService
@using GestioneFerie.Web.Services
@using GestioneFerie.Web.Models
@using GestioneFerie.Web.Data
@using Microsoft.EntityFrameworkCore
@rendermode InteractiveServer

<PageTitle>Pannello Admin</PageTitle>

<div class="page-header">
  <div>
    <h2>Pannello Admin</h2>
    <p class="subtitle">Gestisci le aziende registrate nel sistema</p>
  </div>
  <button class="btn-primary" @onclick="() => mostraModalNuova = true">+ Nuova azienda</button>
</div>

@if (!string.IsNullOrEmpty(messaggio))
{
  <div class="alert @(errore ? "alert-error" : "alert-success")">@messaggio</div>
}

@if (!aziende.Any())
{
  <div class="empty-state">Nessuna azienda ancora. Creane una! 👆</div>
}
else
{
  <div class="table-card">
    <table class="table">
      <thead>
        <tr>
          <th>Azienda</th>
          <th>Capo</th>
          <th>Email capo</th>
          <th>Email malattia</th>
          <th>Dipendenti</th>
        </tr>
      </thead>
      <tbody>
        @foreach (var a in aziende)
        {
          <tr>
            <td><strong>@a.Nome</strong></td>
            <td>@a.Capo?.Nome @a.Capo?.Cognome</td>
            <td>@a.Capo?.Email</td>
            <td>@(string.IsNullOrEmpty(a.EmailMalattia) ? "— (va al capo)" : a.EmailMalattia)</td>
            <td>@conteggioUtenti.GetValueOrDefault(a.Id)</td>
          </tr>
        }
      </tbody>
    </table>
  </div>
}

@if (mostraModalNuova)
{
  <div class="modal-overlay">
    <div class="modal">
      <h3>Nuova azienda</h3>

      <div class="form-group">
        <label>Nome azienda</label>
        <input type="text" @bind="nuovoNomeAzienda" placeholder="Es. Acme S.r.l." />
      </div>
      <div class="form-group">
        <label>Email malattia <span class="hint">(opzionale)</span></label>
        <input type="email" @bind="nuovaEmailMalattia" placeholder="hr@azienda.it" />
      </div>

      <hr style="margin: 1rem 0; border-color: var(--border);" />
      <p style="font-weight:600; margin-bottom:.75rem;">Dati del capo</p>

      <div class="form-row">
        <div class="form-group">
          <label>Nome</label>
          <input type="text" @bind="nuovoNomeCapo" placeholder="Mario" />
        </div>
        <div class="form-group">
          <label>Cognome</label>
          <input type="text" @bind="nuovoCognomeCapo" placeholder="Rossi" />
        </div>
      </div>
      <div class="form-group">
        <label>Email capo</label>
        <input type="email" @bind="nuovaEmailCapo" placeholder="mario.rossi@azienda.it" />
      </div>

      <div class="modal-actions">
        <button class="btn-primary" @onclick="CreaAzienda" disabled="@creando">
          @(creando ? "Creazione..." : "Crea azienda")
        </button>
        <button class="btn-cancel" @onclick="ChiudiModal">Annulla</button>
      </div>
    </div>
  </div>
}

@code {
  List<GestioneFerie.Web.Models.Azienda> aziende = new();
  Dictionary<int, int> conteggioUtenti = new();
  bool mostraModalNuova = false;
  bool creando = false;
  string messaggio = "";
  bool errore = false;

  string nuovoNomeAzienda = "";
  string nuovaEmailMalattia = "";
  string nuovoNomeCapo = "";
  string nuovoCognomeCapo = "";
  string nuovaEmailCapo = "";

  protected override async Task OnInitializedAsync()
  {
    if (!Auth.IsAuthenticated || !Auth.IsSuperAdmin)
    {
      Nav.NavigateTo("/dashboard");
      return;
    }
    await CaricaAziende();
  }

  async Task CaricaAziende()
  {
    using var db = DbFactory.CreateDbContext();
    aziende = await db.Aziende
        .Include(a => a.Capo)
        .OrderBy(a => a.Nome)
        .ToListAsync();

    var ids = aziende.Select(a => a.Id).ToList();
    conteggioUtenti = await db.Utenti
        .Where(u => u.AziendaId != null && ids.Contains(u.AziendaId!.Value) && u.Ruolo == Ruolo.Dipendente)
        .GroupBy(u => u.AziendaId!.Value)
        .ToDictionaryAsync(g => g.Key, g => g.Count());
  }

  async Task CreaAzienda()
  {
    if (string.IsNullOrWhiteSpace(nuovoNomeAzienda) ||
        string.IsNullOrWhiteSpace(nuovoNomeCapo) ||
        string.IsNullOrWhiteSpace(nuovaEmailCapo))
    {
      messaggio = "Compila nome azienda, nome e email del capo.";
      errore = true;
      return;
    }

    creando = true;
    using var db = DbFactory.CreateDbContext();

    if (await db.Utenti.AnyAsync(u => u.Email == nuovaEmailCapo))
    {
      messaggio = "Email capo già in uso.";
      errore = true;
      creando = false;
      return;
    }

    var password = GeneraPassword();

    var capo = new Utente
    {
      Nome = nuovoNomeCapo,
      Cognome = nuovoCognomeCapo,
      Email = nuovaEmailCapo,
      PasswordHash = BCrypt.Net.BCrypt.HashPassword(password),
      Ruolo = Ruolo.Capo
    };
    db.Utenti.Add(capo);
    await db.SaveChangesAsync();

    var azienda = new GestioneFerie.Web.Models.Azienda
    {
      Nome = nuovoNomeAzienda,
      EmailMalattia = string.IsNullOrWhiteSpace(nuovaEmailMalattia) ? null : nuovaEmailMalattia,
      CapoId = capo.Id
    };
    db.Aziende.Add(azienda);
    await db.SaveChangesAsync();

    capo.AziendaId = azienda.Id;
    await db.SaveChangesAsync();

    var emailSnapshot = nuovaEmailCapo;
    var nomeSnapshot = nuovoNomeCapo;
    var nomeAziendaSnapshot = nuovoNomeAzienda;

    messaggio = $"Azienda \"{nuovoNomeAzienda}\" creata! Credenziali inviate a {nuovaEmailCapo}.";
    errore = false;
    ChiudiModal();
    await CaricaAziende();
    await InvokeAsync(StateHasChanged);

    _ = Task.Run(() => EmailService.InviaAsync(
        emailSnapshot,
        $"Benvenuto su Gestione Ferie — {nomeAziendaSnapshot}",
        $"""
        <p>Ciao {nomeSnapshot},</p>
        <p>Il tuo account da <strong>capo</strong> per l'azienda <strong>{nomeAziendaSnapshot}</strong> è stato creato.</p>
        <p>Email: <strong>{emailSnapshot}</strong></p>
        <p>Password: <strong>{password}</strong></p>
        <p>Accedi e aggiungi i tuoi dipendenti dalla sezione <em>Dipendenti</em>.</p>
        """
    ));

    creando = false;
  }

  void ChiudiModal()
  {
    mostraModalNuova = false;
    nuovoNomeAzienda = nuovaEmailMalattia = nuovoNomeCapo = nuovoCognomeCapo = nuovaEmailCapo = "";
  }

  string GeneraPassword()
  {
    const string chars = "ABCDEFGHJKLMNPQRSTUVWXYZabcdefghjkmnpqrstuvwxyz23456789!@#$";
    var random = new Random();
    return new string(Enumerable.Range(0, 12).Select(_ => chars[random.Next(chars.Length)]).ToArray());
  }
}
