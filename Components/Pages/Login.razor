@page "/login"
@inject NavigationManager Nav
@inject AuthService Auth
@using GestioneFerie.Web.Services

<PageTitle>Login</PageTitle>

<div class="login-container">
  <div class="login-card">
    <div class="login-header">
      <h1>🗓️ Gestione Ferie</h1>
      <p>Accedi al tuo account</p>
    </div>

    @if (Nav.Uri.Contains("error=1"))
    {
      <div class="alert-error">Email o password non corretti.</div>
    }

    <form method="post" action="/auth/login">
      <input name="__RequestVerificationToken" type="hidden" value="@antiforgery" />
      <div class="form-group">
        <label>Email</label>
        <input type="email" name="email" placeholder="tuaemail@azienda.it" required />
      </div>
      <div class="form-group">
        <label>Password</label>
        <input type="password" name="password" placeholder="••••••••" required />
      </div>
      <button type="submit" class="btn-login">Accedi</button>
    </form>
  </div>
</div>

@code {
  string antiforgery = "";

  protected override void OnInitialized()
  {
    if (Auth.IsAuthenticated)
    {
      Nav.NavigateTo(Auth.IsSuperAdmin ? "/admin" : "/dashboard");
    }
  }
}