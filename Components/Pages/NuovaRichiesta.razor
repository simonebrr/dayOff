@page "/nuova-richiesta"
@inject AuthService Auth
@inject NavigationManager Nav
@inject RichiesteService Richieste
@using GestioneFerie.Web.Services
@using GestioneFerie.Web.Models
@rendermode InteractiveServer

<PageTitle>Nuova Richiesta</PageTitle>

<div class="page-header">
  <h2>Nuova richiesta</h2>
  <p class="subtitle">Compila il modulo per richiedere ferie, permesso o segnalare una malattia</p>
</div>

@if (!string.IsNullOrEmpty(messaggio))
{
  <div class="alert @(successo ? "alert-success" : "alert-error")">@messaggio</div>
}

@if (tipo != "Malattia")
{
  @if (saldo != null)
  {
    <div class="saldo-bar">
      <div class="saldo-item">
        <span class="saldo-label">Ore totali anno @DateTime.Now.Year</span>
        <span class="saldo-value">@saldo.OreTotali h</span>
      </div>
      <div class="saldo-item">
        <span class="saldo-label">Ore usate</span>
        <span class="saldo-value warning">@saldo.OreUsate h</span>
      </div>
      <div class="saldo-item">
        <span class="saldo-label">Ore disponibili</span>
        <span class="saldo-value success">@saldo.OreDisponibili h</span>
      </div>
    </div>
  }
  else
  {
    <div class="alert alert-error">
      <Icon Name="warning" /> Nessun saldo ferie assegnato per il @DateTime.Now.Year. Contatta il responsabile.
    </div>
  }
}

<div class="form-card">
  <div class="form-group">
    <label>Tipo richiesta</label>
    <select @bind="tipo" @bind:after="CalcolaOre">
      <option value="Ferie">Ferie</option>
      <option value="Permesso">Permesso</option>
      <option value="Malattia">Malattia</option>
    </select>
  </div>

  @if (tipo == "Malattia")
  {
    <div class="form-group">
      <label>Codice malattia</label>
      <input type="text" @bind="codiceMalattia" placeholder="Es. INPS-2026-XXXXXXXX" />
      <span class="hint">Il codice ti viene fornito dal medico curante</span>
    </div>
  }

  <div class="form-row">
    <div class="form-group">
      <label>Data inizio</label>
      <input type="date" min="@DateTime.Today.ToString("yyyy-MM-dd")" value="@dataInizio.ToString("yyyy-MM-dd")"
             @onchange="async e => {
               dataInizio = DateTime.SpecifyKind(DateTime.Parse(e.Value!.ToString()!), DateTimeKind.Local);
               await CalcolaOre();
             }
      " />
    </div>
    <div class="form-group">
      <label>Data fine</label>
      <input type="date" min="@DateTime.Today.ToString("yyyy-MM-dd")" value="@dataFine.ToString("yyyy-MM-dd")"
             @onchange="async e => {
               dataFine = DateTime.SpecifyKind(DateTime.Parse(e.Value!.ToString()!), DateTimeKind.Local);
               await CalcolaOre();
             }
      " />
    </div>
  </div>

  @if (tipo == "Ferie")
  {
    <div class="form-group">
      <label>Giorni lavorativi selezionati</label>
      <div class="ore-display">
        <span class="ore-numero">@giorniLavorativi</span>
        <span class="ore-label">giorni → <strong>@ore ore</strong> (esclusi weekend e festivi italiani)</span>
      </div>
      @if (saldo != null)
      {
        <div class="saldo-preview @(saldo.OreDisponibili - ore < 0 ? "saldo-negativo" : "saldo-positivo")">
          <span>Ore disponibili ora: <strong>@saldo.OreDisponibili</strong></span>
          <span class="arrow">→</span>
          <span>Dopo la richiesta: <strong>@(saldo.OreDisponibili - ore)</strong></span>
          @if (saldo.OreDisponibili - ore < 0)
          {
            <span class="warning-text"><Icon Name="warning" Class="icon-sm" /> Ore insufficienti!</span>
          }
        </div>
      }
    </div>
  }
  else if (tipo == "Permesso")
  {
    <div class="form-group">
      <label>Ore di permesso</label>
      <input type="number" @bind="ore" min="0.5" max="8" step="0.5" placeholder="Es. 4" />
      @if (saldo != null && ore > 0)
      {
        <div class="saldo-preview @(saldo.OreDisponibili - ore < 0 ? "saldo-negativo" : "saldo-positivo")">
          <span>Ore disponibili ora: <strong>@saldo.OreDisponibili</strong></span>
          <span class="arrow">→</span>
          <span>Dopo la richiesta: <strong>@(saldo.OreDisponibili - ore)</strong></span>
          @if (saldo.OreDisponibili - ore < 0)
          {
            <span class="warning-text"><Icon Name="warning" Class="icon-sm" /> Ore insufficienti!</span>
          }
        </div>
      }
    </div>
  }

  <div class="form-group">
    <label>Note (opzionale)</label>
    <textarea @bind="note" placeholder="Aggiungi una nota..."></textarea>
  </div>

  <div class="form-actions">
    <button class="btn-primary" @onclick="InviaRichiesta" disabled="@caricamento">
      @(caricamento ? "Invio in corso..." : "Invia richiesta")
    </button>
    <a href="/dashboard" class="btn-secondary">Annulla</a>
  </div>
</div>

@if (richiedeAutorizzazione)
{
  <div class="modal-overlay">
    <div class="modal-box">
      <h3><Icon Name="warning" Class="icon-warning" /> Preavviso insufficiente</h3>
      @{
        var giorniMancanti = (int)(dataInizio.Date - DateTime.Today.Date).TotalDays;
        var giorniTesto = giorniMancanti == 1 ? "1 giorno" : $"{giorniMancanti} giorni";
      }
      <p>Stai richiedendo <strong>@tipo</strong> con solo <strong>@giorniTesto di preavviso</strong> (minimo richiesto: 4
        giorni).</p>
        <p>La richiesta verrà comunque inviata al capo, che potrà approvarla o rifiutarla.</p>
        <p style="color:#888; font-size:0.9rem">In alternativa, contatta direttamente <strong>@nomeCapo</strong> per
          accordarti.</p>
          <div class="modal-actions">
            <button class="btn-primary" @onclick="InviaConAutorizzazione">Invia comunque</button>
            <button class="btn-cancel" @onclick="() => richiedeAutorizzazione = false">Annulla</button>
          </div>
        </div>
      </div>
    }

@code {
  string tipo = "Ferie";
  DateTime dataInizio = DateTime.Today;
  DateTime dataFine = DateTime.Today;
  decimal ore = 0;
  int giorniLavorativi = 0;
  string note = "";
  string codiceMalattia = "";
  string messaggio = "";
  bool successo = false;
  bool caricamento = false;
  bool richiedeAutorizzazione = false;
  string nomeCapo = "";
  SaldoFerie? saldo;

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (firstRender)
    {
      if (!Auth.IsAuthenticated)
      {
        Nav.NavigateTo("/login");
        return;
      }

      saldo = await Richieste.GetSaldoAsync(Auth.UtenteId!.Value, DateTime.Now.Year);
      nomeCapo = await Richieste.GetNomeCapoAsync(Auth.AziendaId);

      await CalcolaOre();
      StateHasChanged();
    }
  }

  Task CalcolaOre()
  {
    if (tipo == "Ferie")
    {
      giorniLavorativi = HolidayCalculator.GiorniLavorativi(dataInizio, dataFine);
      ore = giorniLavorativi * 8;
    }
    else
    {
      giorniLavorativi = 0;
      if (tipo == "Malattia") ore = 0;
    }
    StateHasChanged();
    return Task.CompletedTask;
  }

  async Task InviaRichiesta()
  {
    if (dataInizio.Date < DateTime.Today.Date)
    {
      messaggio = "Non puoi richiedere ferie per date già passate.";
      successo = false;
      return;
    }
    if (dataFine.Date < dataInizio.Date)
    {
      messaggio = "La data di fine non può essere prima della data di inizio.";
      successo = false;
      return;
    }

    // Controllo preavviso minimo (solo per Ferie e Permesso)
    if (tipo != "Malattia" && RichiesteService.PreavvisoInsufficiente(dataInizio))
    {
      richiedeAutorizzazione = true;
      messaggio = "";
      successo = false;
      StateHasChanged();
      return;
    }

    await EseguiInvio();
  }

  async Task InviaConAutorizzazione()
  {
    richiedeAutorizzazione = false;
    await EseguiInvio();
  }

  async Task EseguiInvio()
  {
    if (tipo == "Malattia" && string.IsNullOrWhiteSpace(codiceMalattia))
    {
      messaggio = "Inserisci il codice malattia.";
      successo = false;
      return;
    }
    if (tipo != "Malattia" && ore <= 0)
    {
      messaggio = tipo == "Ferie"
          ? "Nessun giorno lavorativo nel periodo selezionato."
          : "Inserisci le ore di permesso.";
      successo = false;
      return;
    }

    caricamento = true;
    StateHasChanged();

    if (tipo == "Malattia")
    {
      await Richieste.InviaMalattiaAsync(
          Auth.UtenteId!.Value, Auth.UtenteNome ?? "", dataInizio, dataFine, codiceMalattia, note);
      messaggio = "Malattia segnalata! Il codice è stato inviato all'ufficio HR.";
    }
    else
    {
      await Richieste.InviaFeriePermessoAsync(
          Auth.UtenteId!.Value, Auth.UtenteNome ?? "", Auth.AziendaId,
          Enum.Parse<TipoRichiesta>(tipo), dataInizio, dataFine, ore, note);
      messaggio = "Richiesta inviata con successo! Il capo la esaminerà a breve.";
    }

    successo = true;
    caricamento = false;
    richiedeAutorizzazione = false;
    tipo = "Ferie";
    dataInizio = DateTime.Today;
    dataFine = DateTime.Today;
    note = "";
    codiceMalattia = "";
    await CalcolaOre();
  }
}