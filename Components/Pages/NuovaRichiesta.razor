@page "/nuova-richiesta"
@inject AuthService Auth
@inject NavigationManager Nav
@inject RichiesteService Richieste
@inject GoogleCalendarService GCal
@using GestioneFerie.Web.Services
@using GestioneFerie.Web.Models
@rendermode InteractiveServer

<PageTitle>Nuova Richiesta</PageTitle>

<div class="page-header">
  <h2>Nuova richiesta</h2>
  <p class="subtitle">Compila il modulo per richiedere ferie, permesso o segnalare una malattia</p>
</div>

@if (!string.IsNullOrEmpty(messaggio))
{
  <div class="alert @(successo ? "alert-success" : "alert-error")">@messaggio</div>
}

@if (tipo != "Malattia")
{
  @if (saldo != null)
  {
    <div class="saldo-card">
      <div class="saldo-bar">
        <div class="saldo-item">
          <span class="saldo-label">Ore totali @DateTime.Now.Year</span>
          <span class="saldo-value">@saldo.OreTotali h</span>
        </div>
        <div class="saldo-item">
          <span class="saldo-label">Ore usate</span>
          <span class="saldo-value warning">@saldo.OreUsate h</span>
        </div>
        <div class="saldo-item">
          <span class="saldo-label">Ore disponibili</span>
          <span class="saldo-value success">@saldo.OreDisponibili h</span>
        </div>
      </div>
      @if (saldo.OreTotali > 0)
      {
        <div class="saldo-progress" title="@saldo.OreUsate h su @saldo.OreTotali h utilizzate">
          <div class="saldo-progress-fill" style="width:@(Math.Min(100, (double)saldo.OreUsate / (double)saldo.OreTotali * 100).ToString(System.Globalization.CultureInfo.InvariantCulture))%"></div>
        </div>
      }
    </div>
  }
  else
  {
    <div class="alert alert-error">
      <Icon Name="warning" /> Nessun saldo ferie assegnato per il @DateTime.Now.Year. Contatta il responsabile.
    </div>
  }
}

<div class="form-card">
  <div class="form-group">
    <label>Tipo richiesta</label>
    <div class="tipo-selector">
      <button type="button" class="tipo-opt tipo-ferie @(tipo == "Ferie" ? "active" : "")" @onclick='() => CambiaTipo("Ferie")'>
        <Icon Name="sun" Class="icon-lg" />
        <span>Ferie</span>
      </button>
      <button type="button" class="tipo-opt tipo-permesso @(tipo == "Permesso" ? "active" : "")" @onclick='() => CambiaTipo("Permesso")'>
        <Icon Name="clock" Class="icon-lg" />
        <span>Permesso</span>
      </button>
      <button type="button" class="tipo-opt tipo-malattia @(tipo == "Malattia" ? "active" : "")" @onclick='() => CambiaTipo("Malattia")'>
        <Icon Name="thermometer" Class="icon-lg" />
        <span>Malattia</span>
      </button>
    </div>
  </div>

  @if (tipo == "Malattia")
  {
    <div class="form-group">
      <label>Codice malattia</label>
      <input type="text" @bind="codiceMalattia" placeholder="Es. INPS-2026-XXXXXXXX" />
      <span class="hint">Il codice ti viene fornito dal medico curante</span>
    </div>
  }

  <div class="periodo-wrap">
    <div class="form-row">
      <div class="form-group">
        <label>Data inizio</label>
        <button type="button" class="date-field @(pickerAperto ? "attivo" : "")" @onclick="TogglePicker">
          <Icon Name="calendar" Class="icon-sm icon-muted" /> @dataInizio.ToString("dd/MM/yyyy")
        </button>
      </div>
      <div class="form-group">
        <label>Data fine</label>
        <button type="button" class="date-field @(pickerAperto ? "attivo" : "")" @onclick="TogglePicker">
          <Icon Name="calendar" Class="icon-sm icon-muted" /> @dataFine.ToString("dd/MM/yyyy")
        </button>
      </div>
    </div>

    @if (pickerAperto)
    {
      <div class="picker-backdrop" @onclick="ChiudiPicker"></div>
      <div class="picker-pop">
        <div class="mc-toolbar">
          <button type="button" class="mc-nav-btn" title="Mese precedente" @onclick="PickerMesePrec"><Icon Name="arrow-left" Class="icon-sm" /></button>
          <span class="mc-title">@mesiIt[pickerMese.Month - 1] @pickerMese.Year</span>
          <button type="button" class="mc-nav-btn" title="Mese successivo" @onclick="PickerMeseSucc"><Icon Name="arrow-right" Class="icon-sm" /></button>
        </div>
        <div class="mc-grid mc-head">
          @foreach (var g in giorniSettimana)
          {
            <div class="mc-weekday">@g</div>
          }
        </div>
        <div class="mc-grid">
          @foreach (var d in GiorniGrigliaPicker())
          {
            var fuori = d.Month != pickerMese.Month;
            var passato = d.Date < DateTime.Today;
            var inizio = d.Date == dataInizio.Date;
            var fine = d.Date == dataFine.Date;
            var inRange = d.Date > dataInizio.Date && d.Date < dataFine.Date;
            var oggi = d.Date == DateTime.Today;
            var rosso = IsFestivo(d) || d.DayOfWeek == DayOfWeek.Sunday;
            <button type="button"
                    class="mc-day @(fuori ? "fuori" : "") @(passato ? "disabled" : "") @(inizio ? "start" : "") @(fine ? "end" : "") @(inRange ? "range" : "") @(oggi && !inizio && !fine ? "oggi" : "") @(rosso && !inizio && !fine ? "rosso" : "")"
                    disabled="@passato"
                    title="@(IsFestivo(d) ? "Festività" : null)"
                    @onclick="() => SelezionaGiorno(d)">@d.Day</button>
          }
        </div>
        <div class="picker-foot">
          <span class="picker-hint">@(attesaFine ? "Scegli il giorno di fine" : "Scegli il giorno di inizio")</span>
          <button type="button" class="picker-link" @onclick="ChiudiPicker">Fatto</button>
        </div>
      </div>
    }
  </div>

  @if (tipo == "Ferie")
  {
    <div class="form-group">
      <label>Giorni lavorativi selezionati</label>
      <div class="ore-display">
        <span class="ore-numero">@giorniLavorativi</span>
        <span class="ore-label">giorni → <strong>@ore ore</strong> (esclusi weekend e festivi)</span>
      </div>
      @if (festiviPeriodo.Any())
      {
        <div class="festivi-periodo">
          <Icon Name="calendar" Class="icon-sm" />
          <span>Festività nel periodo (non conteggiate):</span>
          @foreach (var f in festiviPeriodo)
          {
            <span class="festivo-tag">@f.ToString("dd/MM")</span>
          }
        </div>
      }
      @if (saldo != null)
      {
        <div class="saldo-preview @(saldo.OreDisponibili - ore < 0 ? "saldo-negativo" : "saldo-positivo")">
          <span>Ore disponibili ora: <strong>@saldo.OreDisponibili</strong></span>
          <span class="arrow">→</span>
          <span>Dopo la richiesta: <strong>@(saldo.OreDisponibili - ore)</strong></span>
          @if (saldo.OreDisponibili - ore < 0)
          {
            <span class="warning-text"><Icon Name="warning" Class="icon-sm" /> Ore insufficienti!</span>
          }
        </div>
      }
    </div>
  }
  else if (tipo == "Permesso")
  {
    <div class="form-group">
      <label>Ore di permesso</label>
      <input type="number" @bind="ore" min="0.5" max="8" step="0.5" placeholder="Es. 4" />
      @if (saldo != null && ore > 0)
      {
        <div class="saldo-preview @(saldo.OreDisponibili - ore < 0 ? "saldo-negativo" : "saldo-positivo")">
          <span>Ore disponibili ora: <strong>@saldo.OreDisponibili</strong></span>
          <span class="arrow">→</span>
          <span>Dopo la richiesta: <strong>@(saldo.OreDisponibili - ore)</strong></span>
          @if (saldo.OreDisponibili - ore < 0)
          {
            <span class="warning-text"><Icon Name="warning" Class="icon-sm" /> Ore insufficienti!</span>
          }
        </div>
      }
    </div>
  }

  <div class="form-group">
    <label>Note (opzionale)</label>
    <textarea @bind="note" placeholder="Aggiungi una nota..."></textarea>
  </div>

  <div class="form-actions">
    <button class="btn-primary" @onclick="InviaRichiesta" disabled="@caricamento">
      @(caricamento ? "Invio in corso..." : "Invia richiesta")
    </button>
    <a href="/dashboard" class="btn-secondary">Annulla</a>
  </div>
</div>

@if (richiedeAutorizzazione)
{
  <div class="modal-overlay">
    <div class="modal-box">
      <h3><Icon Name="warning" Class="icon-warning" /> Preavviso insufficiente</h3>
      @{
        var giorniMancanti = (int)(dataInizio.Date - DateTime.Today.Date).TotalDays;
        var giorniTesto = giorniMancanti == 1 ? "1 giorno" : $"{giorniMancanti} giorni";
      }
      <p>Stai richiedendo <strong>@tipo</strong> con solo <strong>@giorniTesto di preavviso</strong> (minimo richiesto: 4
        giorni).</p>
        <p>La richiesta verrà comunque inviata al capo, che potrà approvarla o rifiutarla.</p>
        <p style="color:#888; font-size:0.9rem">In alternativa, contatta direttamente <strong>@nomeCapo</strong> per
          accordarti.</p>
          <div class="modal-actions">
            <button class="btn-primary" @onclick="InviaConAutorizzazione">Invia comunque</button>
            <button class="btn-cancel" @onclick="() => richiedeAutorizzazione = false">Annulla</button>
          </div>
        </div>
      </div>
    }

@code {
  string tipo = "Ferie";
  DateTime dataInizio = DateTime.Today;
  DateTime dataFine = DateTime.Today;
  decimal ore = 0;
  int giorniLavorativi = 0;
  string note = "";
  string codiceMalattia = "";
  string messaggio = "";
  bool successo = false;
  bool caricamento = false;
  bool richiedeAutorizzazione = false;
  string nomeCapo = "";
  SaldoFerie? saldo;

  // ---- Popup calendario (selezione periodo) ----
  bool pickerAperto = false;
  DateTime pickerMese = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
  bool attesaFine = false;
  readonly string[] giorniSettimana = { "Lun", "Mar", "Mer", "Gio", "Ven", "Sab", "Dom" };
  readonly string[] mesiIt = { "Gennaio", "Febbraio", "Marzo", "Aprile", "Maggio", "Giugno",
                               "Luglio", "Agosto", "Settembre", "Ottobre", "Novembre", "Dicembre" };

  IEnumerable<DateTime> GiorniGrigliaPicker()
  {
    var primo = new DateTime(pickerMese.Year, pickerMese.Month, 1);
    int offset = ((int)primo.DayOfWeek + 6) % 7;
    var start = primo.AddDays(-offset);
    for (int i = 0; i < 42; i++) yield return start.AddDays(i);
  }

  bool IsFestivo(DateTime d) =>
      _festiviAnno.TryGetValue(d.Year, out var s) && s.Contains(d.Date);

  async Task EnsureFestiviPicker()
  {
    var giorni = GiorniGrigliaPicker().ToList();
    await EnsureFestivi(giorni.First().Year);
    await EnsureFestivi(giorni.Last().Year);
  }

  async Task TogglePicker()
  {
    pickerAperto = !pickerAperto;
    if (pickerAperto)
    {
      pickerMese = new DateTime(dataInizio.Year, dataInizio.Month, 1);
      attesaFine = false;
      await EnsureFestiviPicker();
    }
  }

  void ChiudiPicker() => pickerAperto = false;

  async Task PickerMesePrec() { pickerMese = pickerMese.AddMonths(-1); await EnsureFestiviPicker(); }
  async Task PickerMeseSucc() { pickerMese = pickerMese.AddMonths(1); await EnsureFestiviPicker(); }

  async Task SelezionaGiorno(DateTime d)
  {
    if (d.Date < DateTime.Today) return;

    if (!attesaFine)
    {
      dataInizio = DateTime.SpecifyKind(d.Date, DateTimeKind.Local);
      dataFine = dataInizio;
      attesaFine = true;
    }
    else
    {
      if (d.Date >= dataInizio.Date)
      {
        dataFine = DateTime.SpecifyKind(d.Date, DateTimeKind.Local);
      }
      else
      {
        dataFine = dataInizio;
        dataInizio = DateTime.SpecifyKind(d.Date, DateTimeKind.Local);
      }
      attesaFine = false;
      pickerAperto = false;
    }
    await CalcolaOre();
  }

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (firstRender)
    {
      if (!Auth.IsAuthenticated)
      {
        Nav.NavigateTo("/login");
        return;
      }

      saldo = await Richieste.GetSaldoAsync(Auth.UtenteId!.Value, DateTime.Now.Year);
      nomeCapo = await Richieste.GetNomeCapoAsync(Auth.AziendaId);

      await CalcolaOre();
      StateHasChanged();
    }
  }

  async Task CambiaTipo(string nuovoTipo)
  {
    tipo = nuovoTipo;
    messaggio = "";
    await CalcolaOre();
  }

  readonly Dictionary<int, HashSet<DateTime>> _festiviAnno = new();
  List<DateTime> festiviPeriodo = new();

  async Task<HashSet<DateTime>> EnsureFestivi(int anno)
  {
    if (!_festiviAnno.TryGetValue(anno, out var s))
    {
      s = await GCal.GetFestiviAsync(anno);
      _festiviAnno[anno] = s;
    }
    return s;
  }

  async Task CalcolaOre()
  {
    if (tipo == "Ferie")
    {
      var festivi = new HashSet<DateTime>(await EnsureFestivi(dataInizio.Year));
      if (dataFine.Year != dataInizio.Year)
        festivi.UnionWith(await EnsureFestivi(dataFine.Year));

      giorniLavorativi = HolidayCalculator.GiorniLavorativi(dataInizio, dataFine, festivi);
      ore = giorniLavorativi * 8;

      festiviPeriodo = new();
      if (dataFine.Date >= dataInizio.Date)
        for (var d = dataInizio.Date; d <= dataFine.Date; d = d.AddDays(1))
          if (festivi.Contains(d.Date)) festiviPeriodo.Add(d);
    }
    else
    {
      giorniLavorativi = 0;
      festiviPeriodo = new();
      if (tipo == "Malattia") ore = 0;
    }
    StateHasChanged();
  }

  async Task InviaRichiesta()
  {
    if (dataInizio.Date < DateTime.Today.Date)
    {
      messaggio = "Non puoi richiedere ferie per date già passate.";
      successo = false;
      return;
    }
    if (dataFine.Date < dataInizio.Date)
    {
      messaggio = "La data di fine non può essere prima della data di inizio.";
      successo = false;
      return;
    }

    // Controllo preavviso minimo (solo per Ferie e Permesso)
    if (tipo != "Malattia" && RichiesteService.PreavvisoInsufficiente(dataInizio))
    {
      richiedeAutorizzazione = true;
      messaggio = "";
      successo = false;
      StateHasChanged();
      return;
    }

    await EseguiInvio();
  }

  async Task InviaConAutorizzazione()
  {
    richiedeAutorizzazione = false;
    await EseguiInvio();
  }

  async Task EseguiInvio()
  {
    if (tipo == "Malattia" && string.IsNullOrWhiteSpace(codiceMalattia))
    {
      messaggio = "Inserisci il codice malattia.";
      successo = false;
      return;
    }
    if (tipo != "Malattia" && ore <= 0)
    {
      messaggio = tipo == "Ferie"
          ? "Nessun giorno lavorativo nel periodo selezionato."
          : "Inserisci le ore di permesso.";
      successo = false;
      return;
    }

    caricamento = true;
    StateHasChanged();

    if (tipo == "Malattia")
    {
      await Richieste.InviaMalattiaAsync(
          Auth.UtenteId!.Value, Auth.UtenteNome ?? "", dataInizio, dataFine, codiceMalattia, note);
      messaggio = "Malattia segnalata! Il codice è stato inviato all'ufficio HR.";
    }
    else
    {
      await Richieste.InviaFeriePermessoAsync(
          Auth.UtenteId!.Value, Auth.UtenteNome ?? "", Auth.AziendaId,
          Enum.Parse<TipoRichiesta>(tipo), dataInizio, dataFine, ore, note);
      messaggio = "Richiesta inviata con successo! Il capo la esaminerà a breve.";
    }

    successo = true;
    caricamento = false;
    richiedeAutorizzazione = false;
    tipo = "Ferie";
    dataInizio = DateTime.Today;
    dataFine = DateTime.Today;
    pickerAperto = false;
    attesaFine = false;
    pickerMese = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
    note = "";
    codiceMalattia = "";
    await CalcolaOre();
  }
}