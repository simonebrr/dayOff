@page "/richieste"
@inject IDbContextFactory<AppDbContext> DbFactory
@inject AuthService Auth
@inject NavigationManager Nav
@inject RichiesteService RichiesteSvc
@using GestioneFerie.Web.Services
@using GestioneFerie.Web.Models
@using GestioneFerie.Web.Data
@using Microsoft.EntityFrameworkCore
@rendermode InteractiveServer

<PageTitle>Richieste</PageTitle>

<div class="page-header">
  <h2>Tutte le richieste</h2>
  <p class="subtitle">Gestisci le richieste di ferie e permessi</p>
</div>

@if (!richieste.Any())
{
  <div class="empty-state">Nessuna richiesta trovata 🎉</div>
}
else
{
  <div class="table-card">
    <table class="table">
      <thead>
        <tr>
          <th>Dipendente</th>
          <th>Tipo</th>
          <th>Dal</th>
          <th>Al</th>
          <th>Ore</th>
          <th>Stato</th>
          <th>Note</th>
          <th>Motivo rifiuto</th>
          <th>Azioni</th>
        </tr>
      </thead>
      <tbody>
        @foreach (var r in richieste)
        {
          <tr>
            <td data-label="Dipendente">@r.Utente.Nome @r.Utente.Cognome</td>
            <td data-label="Tipo"><span
              class="badge @BadgeHelper.TipoBadgeClass(r.Tipo)">@r.Tipo</span></td>
              <td data-label="Dal">@r.DataInizio.ToString("dd/MM/yyyy")</td>
              <td data-label="Al">@r.DataFine.ToString("dd/MM/yyyy")</td>
              <td data-label="Ore">@r.OreRichieste</td>
              <td data-label="Stato"><span class="badge @BadgeHelper.StatoBadgeClass(r.Stato)">@r.Stato</span></td>
              <td data-label="Note">@(r.Note ?? "—")</td>
              <td data-label="Motivo rifiuto">@(r.MotivoRifiuto ?? "—")</td>
              <td data-label="Azioni">
                @if (r.Stato == StatoRichiesta.InAttesa)
                {
                  <button class="btn-approve" @onclick="() => Approva(r.Id)">✅ Approva</button>
                  <button class="btn-reject" @onclick="() => ApriRifiuto(r.Id)">❌ Rifiuta</button>
                }
              </td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  }

  @if (mostraModalRifiuto)
  {
    <div class="modal-overlay">
      <div class="modal">
        <h3>Motivo del rifiuto</h3>
        <textarea @bind="motivoRifiuto" placeholder="Inserisci il motivo..."></textarea>
        <div class="modal-actions">
          <button class="btn-reject" @onclick="ConfermaRifiuto">Conferma</button>
          <button class="btn-cancel" @onclick="() => mostraModalRifiuto = false">Annulla</button>
        </div>
      </div>
    </div>
  }
@code {
  List<RichiestaFerie> richieste = new();
  int richiestaRifiutoId;
  string motivoRifiuto = "";
  bool mostraModalRifiuto = false;

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (firstRender)
    {
      if (!Auth.IsAuthenticated || !Auth.IsCapo)
      {
        Nav.NavigateTo("/dashboard");
        return;
      }
      await CaricaRichieste();
      StateHasChanged();
    }
  }

  async Task CaricaRichieste()
  {
    using var db = DbFactory.CreateDbContext();
    richieste = await db.RichiestaFerie
        .Include(r => r.Utente)
        .Where(r => r.Utente.AziendaId == Auth.AziendaId)
        .OrderByDescending(r => r.DataRichiesta)
        .ToListAsync();
  }

  async Task Approva(int id)
  {
    await RichiesteSvc.ApprovaAsync(id);
    await CaricaRichieste();
  }

  void ApriRifiuto(int id)
  {
    richiestaRifiutoId = id;
    motivoRifiuto = "";
    mostraModalRifiuto = true;
  }

  async Task ConfermaRifiuto()
  {
    await RichiesteSvc.RifiutaAsync(richiestaRifiutoId, motivoRifiuto);
    mostraModalRifiuto = false;
    await CaricaRichieste();
  }
}