@page "/azienda"
@inject IDbContextFactory<AppDbContext> DbFactory
@inject AuthService Auth
@inject NavigationManager Nav
@using GestioneFerie.Web.Services
@using GestioneFerie.Web.Models
@using GestioneFerie.Web.Data
@using Microsoft.EntityFrameworkCore
@rendermode InteractiveServer

<PageTitle>Impostazioni Azienda</PageTitle>

<div class="page-header">
  <div>
    <h2>Impostazioni Azienda</h2>
    <p class="subtitle">Configura i dati della tua azienda</p>
  </div>
</div>

@if (!string.IsNullOrEmpty(messaggio))
{
  <div class="alert @(errore ? "alert-error" : "alert-success")">@messaggio</div>
}

@if (azienda != null)
{
  <div class="form-card">
    <div class="form-group">
      <label>Nome azienda</label>
      <input type="text" @bind="nomeAzienda" placeholder="Es. Acme S.r.l." />
    </div>
    <div class="form-group">
      <label>Email malattia <span class="hint">(opzionale — se vuota, le segnalazioni arrivano al capo)</span></label>
      <input type="email" @bind="emailMalattia" placeholder="hr@azienda.it" />
    </div>
    <div class="form-actions">
      <button class="btn-primary" @onclick="Salva">Salva</button>
    </div>
  </div>
}

@code {
  Models.Azienda? azienda;
  string nomeAzienda = "";
  string emailMalattia = "";
  string messaggio = "";
  bool errore = false;

  protected override async Task OnInitializedAsync()
  {
    if (!Auth.IsAuthenticated || !Auth.IsCapo)
    {
      Nav.NavigateTo("/dashboard");
      return;
    }
    using var db = DbFactory.CreateDbContext();
    azienda = await db.Aziende.FirstOrDefaultAsync(a => a.CapoId == Auth.UtenteId);
    if (azienda != null)
    {
      nomeAzienda = azienda.Nome;
      emailMalattia = azienda.EmailMalattia ?? "";
    }
  }

  async Task Salva()
  {
    if (string.IsNullOrWhiteSpace(nomeAzienda))
    {
      messaggio = "Il nome azienda è obbligatorio.";
      errore = true;
      return;
    }
    using var db = DbFactory.CreateDbContext();
    var a = await db.Aziende.FirstOrDefaultAsync(a => a.CapoId == Auth.UtenteId);
    if (a == null) return;
    a.Nome = nomeAzienda;
    a.EmailMalattia = string.IsNullOrWhiteSpace(emailMalattia) ? null : emailMalattia;
    await db.SaveChangesAsync();
    messaggio = "Impostazioni salvate!";
    errore = false;
  }
}
