@page "/mie-richieste"
@inject IDbContextFactory<AppDbContext> DbFactory
@inject AuthService Auth
@inject NavigationManager Nav
@using GestioneFerie.Web.Services
@using GestioneFerie.Web.Models
@using GestioneFerie.Web.Data
@using Microsoft.EntityFrameworkCore
@rendermode InteractiveServer

<PageTitle>Le mie richieste</PageTitle>

<div class="page-header">
  <h2>Le mie richieste</h2>
  <p class="subtitle">Storico di tutte le tue richieste ferie e permessi</p>
  <a href="/nuova-richiesta" class="btn-primary">+ Nuova richiesta</a>
</div>

@if (!richieste.Any())
{
  <div class="empty-state">Non hai ancora fatto nessuna richiesta 🌴</div>
}
else
{
  <div class="table-card">
    <table class="table">
      <thead>
        <tr>
          <th>Tipo</th>
          <th>Dal</th>
          <th>Al</th>
          <th>Ore</th>
          <th>Stato</th>
          <th>Note</th>
          <th>Motivo rifiuto</th>
        </tr>
      </thead>
      <tbody>
        @foreach (var r in richieste)
        {
          <tr>
            <td><span class="badge @BadgeHelper.TipoBadgeClass(r.Tipo)">@r.Tipo</span></td>
            <td>@r.DataInizio.ToString("dd/MM/yyyy")</td>
            <td>@r.DataFine.ToString("dd/MM/yyyy")</td>
            <td>@r.OreRichieste</td>
            <td><span class="badge @BadgeHelper.StatoBadgeClass(r.Stato)">@r.Stato</span></td>
            <td>@(r.Note ?? "—")</td>
            <td>@(r.MotivoRifiuto ?? "—")</td>
          </tr>
        }
      </tbody>
    </table>
  </div>
}

@code {
  List<RichiestaFerie> richieste = new();

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (firstRender)
    {
      if (!Auth.IsAuthenticated)
      {
        Nav.NavigateTo("/login");
        return;
      }
      using var db = DbFactory.CreateDbContext();
      richieste = await db.RichiestaFerie
          .Where(r => r.UtenteId == Auth.UtenteId)
          .OrderByDescending(r => r.DataRichiesta)
          .ToListAsync();
      StateHasChanged();
    }
  }
}