@* Icona SVG inline (stile Lucide), nessuna dipendenza esterna. *@

<svg class="icon @Class" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  @if (Name == "calendar")
  {
    <rect x="3" y="4" width="18" height="18" rx="2" />
    <line x1="16" y1="2" x2="16" y2="6" />
    <line x1="8" y1="2" x2="8" y2="6" />
    <line x1="3" y1="10" x2="21" y2="10" />
  }
  else if (Name == "check-circle")
  {
    <circle cx="12" cy="12" r="9" />
    <polyline points="8,12 11,15 16,9" />
  }
  else if (Name == "x-circle")
  {
    <circle cx="12" cy="12" r="9" />
    <line x1="9" y1="9" x2="15" y2="15" />
    <line x1="15" y1="9" x2="9" y2="15" />
  }
  else if (Name == "x")
  {
    <line x1="6" y1="6" x2="18" y2="18" />
    <line x1="18" y1="6" x2="6" y2="18" />
  }
  else if (Name == "trash")
  {
    <line x1="4" y1="6" x2="20" y2="6" />
    <line x1="9" y1="4" x2="15" y2="4" />
    <line x1="9" y1="4" x2="9" y2="6" />
    <line x1="15" y1="4" x2="15" y2="6" />
    <polyline points="6,6 6,20 18,20 18,6" />
    <line x1="10" y1="10" x2="10" y2="16" />
    <line x1="14" y1="10" x2="14" y2="16" />
  }
  else if (Name == "clock")
  {
    <circle cx="12" cy="12" r="9" />
    <line x1="12" y1="7" x2="12" y2="12" />
    <line x1="12" y1="12" x2="16" y2="14" />
  }
  else if (Name == "users")
  {
    <circle cx="8" cy="8" r="3" />
    <circle cx="16" cy="8" r="3" />
    <circle cx="12" cy="17" r="3" />
  }
  else if (Name == "warning")
  {
    <polygon points="12,3 22,20 2,20" />
    <line x1="12" y1="9" x2="12" y2="14" />
    <circle cx="12" cy="17" r="0.6" fill="currentColor" stroke="none" />
  }
  else if (Name == "sun")
  {
    <circle cx="12" cy="12" r="4" />
    <line x1="12" y1="2" x2="12" y2="5" />
    <line x1="12" y1="19" x2="12" y2="22" />
    <line x1="2" y1="12" x2="5" y2="12" />
    <line x1="19" y1="12" x2="22" y2="12" />
    <line x1="4.9" y1="4.9" x2="7" y2="7" />
    <line x1="17" y1="17" x2="19.1" y2="19.1" />
    <line x1="4.9" y1="19.1" x2="7" y2="17" />
    <line x1="17" y1="7" x2="19.1" y2="4.9" />
  }
  else if (Name == "thermometer")
  {
    <rect x="10" y="2" width="4" height="14" rx="2" />
    <circle cx="12" cy="18" r="4" />
  }
  else if (Name == "pencil")
  {
    <polygon points="17,3 21,7 8,20 3,21 4,16" />
  }
  else if (Name == "download")
  {
    <line x1="12" y1="3" x2="12" y2="15" />
    <polyline points="7,10 12,15 17,10" />
    <line x1="4" y1="17" x2="4" y2="20" />
    <line x1="20" y1="17" x2="20" y2="20" />
    <line x1="4" y1="20" x2="20" y2="20" />
  }
  else if (Name == "clipboard-list")
  {
    <rect x="6" y="4" width="12" height="18" rx="1" />
    <rect x="9" y="2" width="6" height="3" rx="1" />
    <line x1="9" y1="11" x2="15" y2="11" />
    <line x1="9" y1="15" x2="15" y2="15" />
    <line x1="9" y1="19" x2="13" y2="19" />
  }
  else if (Name == "save")
  {
    <rect x="4" y="4" width="16" height="16" rx="1" />
    <rect x="8" y="4" width="8" height="4" />
    <rect x="7" y="13" width="10" height="7" />
  }
  else if (Name == "undo")
  {
    <circle cx="12" cy="12" r="8" stroke-dasharray="38 12" transform="rotate(-40 12 12)" />
    <polyline points="7.5,4.8 4.5,7 7.3,9.6" />
  }
  else if (Name == "dot")
  {
    <circle cx="12" cy="12" r="6" fill="currentColor" stroke="none" />
  }
  else if (Name == "arrow-left")
  {
    <line x1="19" y1="12" x2="5" y2="12" />
    <polyline points="12,19 5,12 12,5" />
  }
  else if (Name == "arrow-right")
  {
    <line x1="5" y1="12" x2="19" y2="12" />
    <polyline points="12,5 19,12 12,19" />
  }
</svg>

@code {
  [Parameter] public string Name { get; set; } = "";
  [Parameter] public string? Class { get; set; }
}
