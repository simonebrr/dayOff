@inherits LayoutComponentBase
@inject NavigationManager Nav
@inject AuthService Auth
@using GestioneFerie.Web.Services
@implements IDisposable

<div class="page">
  @if (Auth.IsAuthenticated)
  {
    <nav class="navbar">
      <div class="navbar-brand"><Icon Name="calendar" Class="icon-lg" /> Gestione Ferie</div>

      <button class="hamburger" id="hamburger" onclick="toggleMenu()">
        <span></span>
        <span></span>
        <span></span>
      </button>

      <div class="navbar-center" id="navbar-center">
        @if (Auth.IsSuperAdmin)
        {
          <a href="/admin" class="nav-link" onclick="return navClick(event)">Admin</a>
        }
        else
        {
          <a href="/dashboard" class="nav-link" onclick="return navClick(event)">Dashboard</a>
          @if (Auth.IsCapo)
          {
            <a href="/dipendenti" class="nav-link" onclick="return navClick(event)">Dipendenti</a>
            <a href="/richieste" class="nav-link" onclick="return navClick(event)">Richieste</a>
          }
          else
          {
            <a href="/nuova-richiesta" class="nav-link" onclick="return navClick(event)">Nuova Richiesta</a>
            <a href="/mie-richieste" class="nav-link" onclick="return navClick(event)">Le mie richieste</a>
          }
          <a href="/calendario" class="nav-link" onclick="return navClick(event)">Calendario</a>
          <a href="/profilo" class="nav-link" onclick="return navClick(event)">Profilo</a>
        }
        <a href="/esci" class="nav-link nav-link-danger only-mobile" onclick="closeMenu()">Esci</a>
      </div>

      <div class="navbar-right">
        <a href="/esci" class="btn-logout only-desktop">Esci</a>
      </div>
    </nav>
  }
  <main class="main-content">
    @Body
  </main>
</div>

@code {
  bool IsLoginPage => Nav.Uri.Contains("/login");

  protected override void OnInitialized()
  {
    Auth.OnChange += AggiornaPagina;

    if (!Auth.IsAuthenticated && !IsLoginPage)
    {
      Nav.NavigateTo("/login");
    }
  }

  void AggiornaPagina() => InvokeAsync(StateHasChanged);

  public void Dispose()
  {
    Auth.OnChange -= AggiornaPagina;
  }
}