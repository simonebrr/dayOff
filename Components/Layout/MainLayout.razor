@inherits LayoutComponentBase
@inject NavigationManager Nav
@inject AuthService Auth
@using GestioneFerie.Web.Services
@implements IDisposable

@if (!Auth.IsAuthenticated && !IsLoginPage)
{
  Nav.NavigateTo("/login");
}
else
{
  <div class="page">
    @if (Auth.IsAuthenticated)
    {
      <nav class="navbar">
        <div class="navbar-brand">🗓️ Gestione Ferie</div>

        <button class="hamburger" id="hamburger" onclick="toggleMenu()">
          <span></span>
          <span></span>
          <span></span>
        </button>

        <div class="navbar-center" id="navbar-center">
          <a href="/dashboard" class="nav-link" onclick="closeMenu()">Dashboard</a>
          @if (Auth.IsCapo)
          {
            <a href="/dipendenti" class="nav-link" onclick="closeMenu()">Dipendenti</a>
            <a href="/richieste" class="nav-link" onclick="closeMenu()">Richieste</a>
            <a href="/azienda" class="nav-link" onclick="closeMenu()">Azienda</a>
          }
          else
          {
            <a href="/nuova-richiesta" class="nav-link" onclick="closeMenu()">Nuova Richiesta</a>
            <a href="/mie-richieste" class="nav-link" onclick="closeMenu()">Le mie richieste</a>
          }
          <a href="/calendario" class="nav-link" onclick="closeMenu()">Calendario</a>
          <a href="/profilo" class="nav-link" onclick="closeMenu()">Profilo</a>
          <a href="/esci" class="nav-link nav-link-danger only-mobile" onclick="closeMenu()">Esci</a>
        </div>

        <div class="navbar-right">
          @* <span class="user-name">@Auth.UtenteNome</span>
          <span class="role-badge @(Auth.IsCapo ? "badge-capo" : "badge-dipendente")">
            @(Auth.IsCapo ? "Capo" : "Dipendente")
          </span>*@
          <a href="/esci" class="btn-logout only-desktop">Esci</a>
        </div>
      </nav>
    }
    <main class="main-content">
      @Body
    </main>
  </div>
}

@code {
  bool IsLoginPage => Nav.Uri.Contains("/login");

  protected override void OnInitialized()
  {
    Auth.OnChange += AggiornaPagina;
  }

  void AggiornaPagina() => InvokeAsync(StateHasChanged);

  public void Dispose()
  {
    Auth.OnChange -= AggiornaPagina;
  }
}